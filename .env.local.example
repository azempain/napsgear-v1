# Web3Forms access key for the /checkout order email.
# 1. Sign up free at https://web3forms.com (enter the inbox you want orders sent to).
# 2. Copy your Access Key.
# 3. cp .env.local.example .env.local  (and paste the key below)
# 4. Restart `pnpm dev` (or rebuild) so Next inlines it.
# NEXT_PUBLIC_ = inlined into the static bundle at build. This is fine for
# Web3Forms: the key only permits sending to the inbox you registered.
NEXT_PUBLIC_WEB3FORMS_KEY=your-access-key-here

# Absolute origin used by sitemap.xml, robots.txt, and JSON-LD metadata.
# No trailing slash. In production set this to your real domain via the
# Vercel project's Environment Variables UI. Default (used when unset) is
# the project's Vercel preview URL placeholder.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Hosted Neon Auth endpoint. This keeps authentication compatible with the
# static export because auth requests go directly to Neon's Better Auth service.
NEXT_PUBLIC_NEON_AUTH_URL=https://your-endpoint.neonauth.region.aws.neon.tech/neondb/auth

# Neon Data API endpoint. The browser SDK combines this with Neon Auth and
# sends the user's JWT so Postgres row-level security can protect order data.
NEXT_PUBLIC_NEON_DATA_API_URL=https://your-endpoint.apirest.region.aws.neon.tech/neondb/rest/v1
