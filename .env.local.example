# Web3Forms access key for the /checkout order email.
# 1. Sign up free at https://web3forms.com (enter the inbox you want orders sent to).
# 2. Copy your Access Key.
# 3. cp .env.local.example .env.local  (and paste the key below)
# 4. Restart `pnpm dev` (or rebuild) so Next inlines it.
# NEXT_PUBLIC_ = inlined into the static bundle at build. This is fine for
# Web3Forms: the key only permits sending to the inbox you registered.
NEXT_PUBLIC_WEB3FORMS_KEY=your-access-key-here

# Bitcoin checkout instructions shown after order submission and included in
# the Web3Forms order email. The payment URL may contain {reference} and
# {total} placeholders, which are URL-encoded at runtime.
NEXT_PUBLIC_BTC_WALLET_ADDRESS=your-btc-wallet-address
NEXT_PUBLIC_BTC_PAYMENT_URL=https://payments.example.com/bitcoin?ref={reference}&amount={total}

# Direct support channels used on contact/help pages and the site-wide
# WhatsApp chat button. Use an international WhatsApp number, e.g. +15551234567.
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
NEXT_PUBLIC_SUPPORT_WHATSAPP=+15551234567

# Absolute origin used by sitemap.xml, robots.txt, and JSON-LD metadata.
# No trailing slash. In production set this to your real domain via the
# Vercel project's Environment Variables UI. Default (used when unset) is
# the project's Vercel preview URL placeholder.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Hosted Neon Auth endpoint. This keeps authentication compatible with the
# static export because auth requests go directly to Neon's Better Auth service.
NEXT_PUBLIC_NEON_AUTH_URL=https://your-endpoint.neonauth.region.aws.neon.tech/neondb/auth

# Neon Data API endpoint. The browser SDK combines this with Neon Auth and
# sends the user's JWT so Postgres row-level security can protect order data.
NEXT_PUBLIC_NEON_DATA_API_URL=https://your-endpoint.apirest.region.aws.neon.tech/neondb/rest/v1

# hCaptcha SITE key (public — safe to inline). Gates the checkout order email
# and the password-reset request against bot abuse.
#   - Checkout: also enable hCaptcha in your Web3Forms dashboard and paste the
#     matching hCaptcha SECRET there. Web3Forms then rejects any submission
#     without a valid h-captcha-response token.
#   - Forgot-password: the client sends the token as the x-captcha-response
#     header, but this is a CLIENT-SIDE gate only. Server enforcement needs
#     Better Auth's captcha plugin, and Neon Auth (which hosts Better Auth for
#     us) does NOT currently expose that plugin in its managed Plugins catalog —
#     so there is no toggle to enable and the header is ignored upstream for now.
#     Use Neon Auth's built-in rate limiting against reset-email-bombing until
#     Neon surfaces the captcha plugin.
# Left unset, the app uses hCaptcha's always-passes TEST key and the captcha is
# a visible-but-non-blocking dev placeholder.
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=your-hcaptcha-site-key
